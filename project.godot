; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="StellarTD"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameEvents="*res://scripts/game_events.gd"
FactoryClock="*res://scripts/factory_clock.gd"
SaveManager="*res://scripts/save/save_manager.gd"
Inventory="*res://scripts/inventory.gd"
PipeNetwork="*res://scripts/pipe_network.gd"
FoundationNetwork="*res://scripts/foundation_network.gd"
PlanetPhysics="*res://scripts/planet_physics.gd"
RadiationSignature="*res://scripts/radiation_signature.gd"
UiState="*res://scripts/ui_state.gd"
QuestManager="*res://scripts/quest_manager.gd"
Progression="*res://scripts/progression.gd"
PowerNetwork="*res://scripts/power_network.gd"
GameSettings="*res://scripts/settings.gd"
UiSound="*res://scripts/ui/kit/ui_sound.gd"
WorldFx="*res://scripts/world_fx.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
; 4x MSAA. Terrain at range is sub-pixel triangles against a black sky, which
; without multisampling sparkles as geometry edges flicker in and out. It looks
; exactly like a shader artifact and survived every shading fix tried against
; it - because it is a geometry problem and needs a geometry-level solution.
anti_aliasing/quality/msaa_3d=2
; FXAA on top: MSAA does not touch shading aliasing, and procedural surface
; detail produces plenty of that.
anti_aliasing/quality/screen_space_aa=1
; Look rule (docs/game/art-direction.md, Michael 2026-11-05): PS2-styled ASSETS, MODERN rendering - per-pixel
; lighting so normal maps, specular and soft shadows read. (Was force_vertex_shading=true, PS2-era Gouraud.)
shading/overrides/force_vertex_shading=false
; Soft PCSS sun shadows need resolution: an 8k directional map, highest soft-shadow quality.
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
; Terrain is mostly seen at grazing angles: 16x anisotropic keeps triplanar texture sharp toward the horizon.
textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=3
environment/ssil/quality=2

[gui]

theme/custom="res://ui/stellar_theme.tres"
